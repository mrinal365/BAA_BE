# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Database Settings
# PostgreSQL Connection String (Format: postgresql://username:password@host:port/database_name)
DATABASE_URL=postgresql://postgres:password@localhost:5432/baa_dev

# MongoDB Connection String (Format: mongodb://host:port/database_name)
MONGODB_URI=mongodb://127.0.0.1:27017/baa_dev

# Database Connection Pool Configuration
PG_MAX_POOL=10
PG_MIN_POOL=2
MONGO_MAX_POOL=10
MONGO_MIN_POOL=2

# Security & CORS
# Replace with a long random string for production
JWT_SECRET=your_super_secret_jwt_secret_key_change_me
CORS_ORIGIN=*
